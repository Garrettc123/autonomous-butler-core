# Copy to secrets.yaml and fill in values
apiVersion: v1
kind: Secret
metadata:
  name: butler-secrets
  namespace: autonomous-butler
type: Opaque
stringData:
  anthropic-api-key: "sk-ant-YOUR-KEY"
  openai-api-key: "sk-YOUR-KEY"
  github-token: "ghp_YOUR-TOKEN"
  linear-api-key: "lin_YOUR-KEY"
  stripe-secret-key: "sk_live_YOUR-KEY"
  stripe-webhook-secret: "whsec_YOUR-WEBHOOK-SECRET"
  stripe-usage-price-id: "price_YOUR-METERED-PRICE-ID"
  stripe-acquisition-price-id: "price_YOUR-ACQUISITION-PRICE-ID"
  clearbit-api-key: "sk_YOUR-CLEARBIT-KEY"
  hunter-api-key: "YOUR-HUNTER-KEY"
  icp-keywords: "devops,platform-engineering,sre"
  slack-webhook-url: "https://hooks.slack.com/YOUR-WEBHOOK"