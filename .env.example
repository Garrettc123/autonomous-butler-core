# ===================================
# AUTONOMOUS BUTLER CONFIGURATION
# ===================================

# --- AI Models ---
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
OPENAI_API_KEY=sk-your-openai-key-here

# --- GitHub Integration ---
GITHUB_TOKEN=ghp_your_github_pat_here
GITHUB_USERNAME=Garrettc123
GITHUB_ORG=Garrettc123

# --- Linear Project Management ---
LINEAR_API_KEY=lin_api_your_linear_key_here
LINEAR_TEAM_ID=your-team-id

# --- Stripe Revenue ---
STRIPE_SECRET_KEY=sk_live_your_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_USAGE_PRICE_ID=price_your_metered_price_id
# Price charged to newly acquired prospects; required to invoice them.
STRIPE_ACQUISITION_PRICE_ID=price_your_acquisition_price_id

# --- Revenue Streams ---
# Comma-separated stream ids, or "all" to enable every stream.
# Valid ids: acquisition, subscriptions, usage_based, one_time, dunning, expansion
REVENUE_STREAMS=all

# --- Customer Acquisition (lead gen + enrichment) ---
# Keywords describing your ideal customer profile. Lead discovery is a no-op
# while this is empty. Requires GITHUB_TOKEN for the GitHub lead source.
ICP_KEYWORDS=devops,platform-engineering,sre
# Minimum lead score (0-100) before a prospect is invoiced.
LEAD_QUALIFY_SCORE=55
# Optional enrichment providers; each is skipped when its key is absent.
CLEARBIT_API_KEY=sk_your_clearbit_key
HUNTER_API_KEY=your_hunter_key

# --- Infrastructure ---
KUBERNETES_CONFIG_PATH=/root/.kube/config
KUBERNETES_CONTEXT=production
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=us-east-1

# --- Event Mesh ---
KAFKA_BROKERS=kafka:9092
KAFKA_CONSUMER_GROUP=autonomous-butler
REDIS_URL=redis://redis:6379

# --- Database ---
POSTGRES_URL=postgresql://butler:butler@postgres:5432/butler

# --- Monitoring ---
PROMETHEUS_URL=http://prometheus:9090
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
PAGERDUTY_API_KEY=your-pagerduty-key

# --- Configuration ---
ENVIRONMENT=production
LOG_LEVEL=INFO
AUTO_DEPLOY_ENABLED=true
AUTO_HEAL_ENABLED=true
AUTO_SCALE_ENABLED=true